# Virtual environment (rebuilt from requirements.txt, never shared)
.venv/

# Python cache files (rebuilt automatically every time Python runs)
__pycache__/
*.pyc
.pytest_cache/

# macOS system files
.DS_Store

# Personal settings (contains your email address) - never upload
local_settings.py

# Downloaded and processed data (can always be downloaded again)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep