# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.pyc
.pytest_cache/

# macOS
.DS_Store

# Private settings (your SEC User-Agent): never commit
local_settings.py

# Downloaded and processed data (re-created by the code); keep the empty folders
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Charts (re-created every time you run main.py)
outputs/
outputs/
